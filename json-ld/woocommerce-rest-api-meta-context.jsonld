{
  "@context": {
    "@version": 1.1,
    "woo": "https://woocommerce.dev/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "MetaData": "woo:MetaData",
    "id": {
      "@id": "woo:id",
      "@type": "xsd:integer"
    },
    "key": {
      "@id": "woo:key",
      "@type": "xsd:string"
    },
    "value": {
      "@id": "woo:value",
      "@type": "xsd:string"
    }
  }
}
{
  "@context": {
    "@version": 1.1,
    "woo": "https://woocommerce.dev/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "WebhookInput": "woo:WebhookInput",
    "name": "schema:name",
    "status": {
      "@id": "woo:status",
      "@type": "xsd:string"
    },
    "topic": {
      "@id": "woo:topic",
      "@type": "xsd:string"
    },
    "deliveryUrl": {
      "@id": "woo:delivery_url",
      "@type": "@id"
    },
    "secret": {
      "@id": "woo:secret",
      "@type": "xsd:string"
    }
  }
}
{
  "@context": {
    "@version": 1.1,
    "woo": "https://woocommerce.dev/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "BatchProductRequest": "woo:BatchProductRequest",
    "create": {
      "@id": "woo:create",
      "@container": "@set"
    },
    "update": {
      "@id": "woo:update",
      "@container": "@set"
    },
    "delete": {
      "@id": "woo:delete",
      "@container": "@set",
      "@type": "xsd:integer"
    },
    "BatchProductResponse": "woo:BatchProductResponse"
  }
}
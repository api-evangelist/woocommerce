{
  "@context": {
    "@version": 1.1,
    "woo": "https://woocommerce.dev/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "CouponInput": "woo:CouponInput",
    "code": {
      "@id": "woo:code",
      "@type": "xsd:string"
    },
    "amount": {
      "@id": "woo:amount",
      "@type": "xsd:string"
    },
    "discountType": {
      "@id": "woo:discount_type",
      "@type": "xsd:string"
    },
    "description": "schema:description",
    "dateExpires": {
      "@id": "woo:date_expires",
      "@type": "xsd:dateTime"
    },
    "individualUse": {
      "@id": "woo:individual_use",
      "@type": "xsd:boolean"
    },
    "productIds": {
      "@id": "woo:product_ids",
      "@container": "@set",
      "@type": "xsd:integer"
    },
    "excludedProductIds": {
      "@id": "woo:excluded_product_ids",
      "@container": "@set",
      "@type": "xsd:integer"
    },
    "usageLimit": {
      "@id": "woo:usage_limit",
      "@type": "xsd:integer"
    },
    "usageLimitPerUser": {
      "@id": "woo:usage_limit_per_user",
      "@type": "xsd:integer"
    },
    "minimumAmount": {
      "@id": "woo:minimum_amount",
      "@type": "xsd:string"
    },
    "maximumAmount": {
      "@id": "woo:maximum_amount",
      "@type": "xsd:string"
    },
    "metaData": {
      "@id": "woo:meta_data",
      "@container": "@set"
    }
  }
}
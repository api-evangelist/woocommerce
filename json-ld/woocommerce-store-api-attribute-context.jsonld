{
  "@context": {
    "@version": 1.1,
    "woo": "https://woocommerce.dev/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "AttributeTerm": "woo:AttributeTerm",
    "id": {
      "@id": "woo:id",
      "@type": "xsd:integer"
    },
    "name": "schema:name",
    "slug": {
      "@id": "woo:slug",
      "@type": "xsd:string"
    },
    "description": "schema:description",
    "count": {
      "@id": "woo:count",
      "@type": "xsd:integer"
    }
  }
}
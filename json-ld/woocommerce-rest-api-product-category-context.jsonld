{
  "@context": {
    "@version": 1.1,
    "woo": "https://woocommerce.dev/schema/",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "ProductCategoryInput": "woo:ProductCategoryInput",
    "name": "schema:name",
    "slug": {
      "@id": "woo:slug",
      "@type": "xsd:string"
    },
    "parent": {
      "@id": "woo:parent",
      "@type": "xsd:integer"
    },
    "description": "schema:description",
    "display": {
      "@id": "woo:display",
      "@type": "xsd:string"
    }
  }
}
{
  "opencollection": "1.0.0",
  "info": {
    "name": "WooCommerce REST Cart Product Tags API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Product Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "WooCommerce List Product Tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://example.com/wp-json/wc/v3/products/tags",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Current page of the collection."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Maximum number of items per page (maximum 100)."
              }
            ]
          },
          "docs": "Returns all product tags used in the store catalog."
        }
      ]
    }
  ],
  "bundled": true
}
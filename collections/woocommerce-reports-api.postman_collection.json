          "name": "WooCommerce Retrieve a Sales Report",
          "request": {
            "name": "WooCommerce Retrieve a Sales Report",
            "description": {
              "content": "Returns aggregate sales data for a given date period. Includes totals for orders, items, discounts, shipping, refunds, taxes, and net sales. Supports period shortcuts (week, month, last_month, year) and custom date ranges.",
              "type": "text/plain"
            },
            "url": {

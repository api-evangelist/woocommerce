                "reports",
                "sales"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "period",
                  "value": "<string>",
                  "description": "Report period shortcut. Options: week, month, last_month, year."
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<dateTime>",
                  "description": "Limit response to resources created after a given ISO8601 compliant date."
                },
                {

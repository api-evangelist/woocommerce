              "content": "Deletes a product category by ID. Set force to true to permanently delete. Requires that no products are assigned to the category, or use force to bypass this restriction.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "products",
                "categories",
                ":id"
              ],
              "host": [
